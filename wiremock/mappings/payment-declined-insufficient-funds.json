{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/payments/validate",
    "bodyPatterns": [ { "matchesJsonPath": "$.paymentMethod[?(@.token == 'tok_insufficient_funds')]" } ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "status": "DECLINED", "reason": "INSUFFICIENT_FUNDS" }
  }
}
