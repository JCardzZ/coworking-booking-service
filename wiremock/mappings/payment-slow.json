{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/payments/validate",
    "bodyPatterns": [ { "matchesJsonPath": "$[?(@.amount == 333)]" } ]
  },
  "response": {
    "status": 200,
    "fixedDelayMilliseconds": 3000,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "status": "APPROVED" }
  }
}
